# 비밀 값: API 키와 비밀번호는 .env에만 두고, 이름만 .env.example에 적어 올립니다.
.env
.env.*
!.env.example

# 키 파일: 서비스 계정 키, OAuth 토큰, 인증서와 개인 키
credentials*.json
token*.json
*.pem

# 개인 설정
.claude/settings.local.json
.vscode/
.idea/

# 운영체제가 만드는 파일
.DS_Store
Thumbs.db
desktop.ini

# Node.js
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# 빌드 결과와 로그
dist/
build/
*.log
